# URL cua backend Spring Boot (chay tren may dev, port 8080).
# - Chay app bang Expo Go tren dien thoai thuc: dung IP LAN cua may dev (vd 192.168.1.38),
#   dien thoai va may dev phai cung 1 mang Wi-Fi. Xem IP bang lenh `ipconfig` (Windows).
# - Chay bang Android Emulator: dung http://10.0.2.2:8080 (dia chi dac biet tro ve localhost may dev).
EXPO_PUBLIC_API_URL=http://192.168.1.38:8080
